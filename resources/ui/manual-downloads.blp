using Gtk 4.0;
using Adw 1;

Adw.Dialog dialog {
  title: "Manual Downloads";
  content-width: 600;
  content-height: 560;
  width-request: 360;
  height-request: 294;
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}
    content: Gtk.ScrolledWindow {
      propagate-natural-height: false;
      vexpand: true;
      hexpand: true;
      halign: fill;
      child: Adw.PreferencesPage page {
        hexpand: true;
        halign: fill;
      };
    };
  };
}
