using Gtk 4.0;
using Adw 1;

Gtk.Box page {
  orientation: vertical;
  spacing: 6;
  margin-top: 6;
  margin-start: 12;
  margin-end: 12;
  vexpand: true;

  Gtk.SearchEntry search_entry {
    placeholder-text: "Search models";
    hexpand: true;
  }

  Adw.StatusPage empty_page {
    icon-name: "network-offline-symbolic";
    title: "Catalogue unavailable";
    description: "Check your connection and try again.";
    vexpand: true;
    visible: false;

    child: Gtk.Button retry_button {
      label: "Try Again";
      halign: center;
      styles ["suggested-action"]
    };
  }

  Gtk.ScrolledWindow scroller {
    vexpand: true;
    hexpand: true;

    child: Gtk.ListBox list_box {
      selection-mode: none;
      styles ["boxed-list"]
    };
  }
}
