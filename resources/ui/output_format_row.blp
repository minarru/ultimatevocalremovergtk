using Gtk 4.0;
using Adw 1;

template $OutputFormatRow: Adw.ActionRow {
  title: "Format";

  [suffix]
  Gtk.Box {
    orientation: horizontal;
    spacing: 0;
    valign: center;
    styles ["linked"]

    Gtk.DropDown format_drop {
      valign: center;
      width-request: 96;
    }

    Gtk.DropDown quality_drop {
      valign: center;
      width-request: 132;
    }
  }
}
