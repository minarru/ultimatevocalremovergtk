using Gtk 4.0;
using Adw 1;

// Compare Stems' own header widgets; the shared surface hosts them.
Gtk.Button folder_button {
  icon-name: "folder-open-symbolic";
  tooltip-text: "Open output folder";

  accessibility {
    label: "Open output folder";
  }
}

// One input names the song under the title; several swap in a picker.
Gtk.Box title_box {
  Adw.WindowTitle window_title {
    title: "Compare Stems";
  }

  Gtk.DropDown input_dropdown {
    visible: false;
    tooltip-text: "Input file";

    styles [
      "flat",
    ]
  }
}
