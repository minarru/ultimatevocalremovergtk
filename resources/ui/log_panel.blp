using Gtk 4.0;

template $LogPanel: Gtk.Box {
  orientation: vertical;
  halign: center;
  valign: end;
  width-request: 360;
  overflow: hidden;
  styles ["uvr-log-panel", "card"]

  Gtk.Box {
    orientation: vertical;
    // Keep the floating panel's inset outside the expanding sections.
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    Gtk.Revealer progress_revealer {
      transition-type: slide_down;
      transition-duration: 200;

      Gtk.Box progress_section {
        orientation: vertical;
        margin-bottom: 4;

        Gtk.ProgressBar progressbar { show-text: false; }

        Gtk.Label progress_label {
          halign: center;
          visible: false;
          margin-top: 4;
          margin-bottom: 8;
          styles ["uvr-progress-label"]
        }
      }
    }

    Gtk.Revealer log_revealer {
      transition-type: slide_up;
      transition-duration: 200;

      Gtk.Box {
        orientation: vertical;

        Gtk.Box log_meta_row {
          spacing: 6;
          height-request: 32;
          margin-bottom: 8;

          Gtk.Image {
            icon-name: "utilities-terminal-symbolic";
            pixel-size: 16;
            accessible-role: presentation;
            styles ["dim-label"]
          }

          Gtk.Label log_title {
            label: _("Log");
            xalign: 0;
            hexpand: true;
            styles ["heading"]
          }

          Gtk.Button log_copy_button {
            icon-name: "edit-copy-symbolic";
            tooltip-text: _("Copy full log");
            accessibility { label: _("Copy full log"); }
            styles ["flat"]
          }

          Gtk.Button log_clear_button {
            icon-name: "eraser3-symbolic";
            tooltip-text: _("Clear the log");
            accessibility { label: _("Clear the log"); }
            styles ["flat"]
          }
        }

        Gtk.Stack log_stack {
          overflow: hidden;
          height-request: 200;
          margin-bottom: 12;
          styles ["uvr-log-body"]

          Gtk.StackPage {
            name: "empty";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 6;
              valign: center;
              halign: center;
              margin-top: 20;
              margin-bottom: 20;
              margin-start: 16;
              margin-end: 16;

              Gtk.Image {
                icon-name: "utilities-terminal-symbolic";
                pixel-size: 36;
                opacity: 0.45;
                accessible-role: presentation;
              }

              Gtk.Label {
                label: _("No activity yet");
                styles ["title-4"]
              }

              Gtk.Label {
                label: _("Start a process to see its log here.");
                wrap: true;
                justify: center;
                max-width-chars: 36;
                styles ["uvr-log-empty-description"]
              }
            };
          }
        }
      }
    }

    Gtk.Box {
      spacing: 6;
      height-request: 36;

      Gtk.ToggleButton expand_button {
        icon-name: "adw-expander-arrow-symbolic";
        valign: center;
        styles ["flat", "uvr-log-expander-arrow"]
      }

      Gtk.Button start_button {
        label: _("_Start Processing");
        use-underline: true;
        hexpand: true;
        valign: center;
        styles ["suggested-action"]
      }

      Gtk.Button stop_button {
        icon-name: "process-stop-symbolic";
        tooltip-text: _("Stop processing");
        accessibility { label: _("Stop processing"); }
        sensitive: false;
        valign: center;
        styles ["destructive-action"]
      }
    }
  }
}
