{
  "include": [
    "ui",
    "cli",
    "core",
    "engines",
    "tests",
    "bundled",
    "ml",
    "scripts",
    "__version__.py"
  ],

  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/node_modules",
    "vendor/demucs",
    "models"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": "typings",
  "extraPaths": ["scripts"],
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": false,
  "reportUninitializedInstanceVariable": false,
  "reportUnknownMemberType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  // Unknown parameter/lambda types remain disabled; third-party GI/ML APIs make
  // these too noisy to be worth the annotations.
  "reportUnknownParameterType": "none",
  "reportUnknownLambdaType": "none",
  "reportMissingParameterType": "error",
  // Off deliberately: `from bundled.constants import *` mirrors upstream's flat
  // namespace (see docs/development-architecture.md), which these two rules cannot distinguish from
  // real dead imports or accidental shadowing.
  "reportUnusedImport": "none",
  "reportConstantRedefinition": "none",
  // Bare `list` / `dict` annotations are pervasive in the ported ml/ layer.
  "reportMissingTypeArgument": "none",
  "reportUnusedCallResult": "none",
  "reportImplicitOverride": "none",
  "reportPrivateUsage": "none",
  "reportInvalidTypeForm": "none",
  // Strict-mode rules kept on: these catch dead branches and leftover debris
  // from refactors, which is where real bugs hide.
  "reportUnnecessaryComparison": "error",
  "reportUnnecessaryIsInstance": "error",
  "reportUnnecessaryCast": "error",
  "reportUnnecessaryContains": "error",
  "reportUnusedVariable": "error",
  // Off: these only look within the declaring file, so the `_`-prefixed helpers
  // that tests import (ui.errorlog._summary_viewport_height,
  // ui.run_control._format_mmss) all read as dead.
  "reportUnusedFunction": "none",
  "reportUnusedClass": "none"
}
