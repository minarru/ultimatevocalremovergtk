# Machine-readable sidecar for docs/models-catalogue.md. Regenerated with the
# document and tied to it by digest, so a checked-in copy would only ever go
# stale; the publication guard falls back to the document when it is absent.
docs/models-catalogue.ir.json

# Legacy catalogue caches. These moved under CACHE_DIR; the entries stay so a
# checkout that still has the old directories does not show them as untracked.
# Safe to delete: nothing reads them any more.
docs/.yaml_cache/
docs/.politrees_cache/
docs/.community_cache/


# Generated GResource manifest (rebuilt by resources/compile_resources.sh)
resources/uvr.gresource.xml
# Ignore local .cursor contents but keep the committed Cloud Agent environment.
.cursor/*
!.cursor/environment.json
!.cursor/install.sh
resources/icons/scalable/actions/bug-symbolic.svg
resources/icons/scalable/actions/cross-small-symbolic.svg

# Subagent-driven-development scratch (any depth, including worktrees)
.superpowers/
**/.superpowers/

# Obsolete agent archives — local only; do not re-commit
docs/plans/
docs/reviews/

# Git worktrees (local isolation)
.worktrees/
